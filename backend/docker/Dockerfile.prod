# Production image — multi-stage build, non-root user, no reload
# Stage 1: install Python dependencies into an isolated prefix
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install into /root/.local so they can be copied cleanly to the runtime stage
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: lean runtime image
FROM python:3.11-slim

WORKDIR /app

# Runtime-only native libs (libpq for asyncpg, curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl && rm -rf /var/lib/apt/lists/*

# Create a non-root user; packages will live under their home dir
RUN useradd -m -u 1000 appuser

# Copy pip-installed packages from builder into the non-root user's local bin
COPY --from=builder /root/.local /home/appuser/.local

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Copy application source, owned by non-root user
COPY --chown=appuser:appuser . .

USER appuser

# Render routes traffic only once this check passes, preventing zombie instances
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

EXPOSE 8000

# entrypoint.sh routes on $1:
#   'api'    → alembic upgrade head + uvicorn (API service)
#   'celery' → skip migrations, exec celery (worker service)
ENTRYPOINT ["docker/entrypoint.sh"]

# 'api' signals the entrypoint to run migrations then start uvicorn.
# Render worker overrides this via dockerCommand: celery ...
CMD ["api"]
